// Educational model of an AND/multiplication gate missing public binding.
// The honest witness generator computes a*b, but constrain() never ties
// the PUBLIC @out member to that value.
module attributes {llzk.lang = "workshop"} {
  struct.def @AND {
    struct.member @out : !felt.type {llzk.pub}
    function.def @compute(%a: !felt.type, %b: !felt.type) -> !struct.type<@AND> {
      %self = struct.new : !struct.type<@AND>
      %product = felt.mul %a, %b : !felt.type, !felt.type
      struct.writem %self[@out] = %product : !struct.type<@AND>, !felt.type
      function.return %self : !struct.type<@AND>
    }
    function.def @constrain(%self: !struct.type<@AND>, %a: !felt.type, %b: !felt.type) {
      %product = felt.mul %a, %b : !felt.type, !felt.type
      // BUG: forgot `constrain.eq %out, %product : !felt.type, !felt.type`.
      function.return
    }
  }
}
